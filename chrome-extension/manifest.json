{
  "manifest_version": 3,
  "name": "ResumeOps",
  "version": "0.1.0",
  "description": "Evaluate any job posting against your profile in one click",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.gupy.io/*",
        "https://boards.greenhouse.io/*/jobs/*",
        "https://jobs.lever.co/*/*",
        "https://jobs.ashbyhq.com/*/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "tabs", "activeTab", "cookies", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.gupy.io/*",
    "https://boards.greenhouse.io/*/jobs/*",
    "https://jobs.lever.co/*/*",
    "https://jobs.ashbyhq.com/*/*",
    "http://localhost:3000/*",
    "https://resumeops.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
